{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start NexusOS dev server",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"nexus-os",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"runOptions": {
				"runOn": "folderOpen"
			},
			"problemMatcher": []
		}
	]
}
